#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  title "AprilTag Track and Follow Test"
  basicTimeStep 32
}

Viewpoint {
  orientation -0.2 0.2 0.96 1.2
  position 0.3 -0.4 0.4
  follow "follower_robot"
}

TexturedBackground {
}

TexturedBackgroundLight {
}

# Larger floor for robot movement
Solid {
  name "floor"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.9 0.9
        roughness 1
        metalness 0
      }
      geometry Box {
        size 5 5 0.001
      }
    }
  ]
  boundingObject Box {
    size 5 5 0.001
  }
}

# Moving AprilTag cube (no physics - moved programmatically)
DEF MOVING_TAG Solid {
  translation 0.5 0 0.0275
  name "moving_apriltag"
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture {
          url ["../textures/real_tag36h11_id0.png"]
        }
        roughness 1
        metalness 0
      }
      geometry Box {
        size 0.055 0.055 0.055  # 5.5cm cube
      }
    }
  ]
}

# E-puck robot with supervisor privileges
E-puck {
  translation 0 0 0
  name "follower_robot"
  controller "apriltag_tracker_follower"
  supervisor TRUE
  camera_width 640
  camera_height 480
  camera_fieldOfView 1.0
}