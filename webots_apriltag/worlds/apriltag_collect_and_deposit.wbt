# E-puck robot with supervisor privileges
E-puck {
  translation -0.5 0 0
  name "collector_depositor_robot"
  controller "apriltag_collector_depositor"
  supervisor TRUE
  camera_width 640
  camera_height 480
  camera_fieldOfView 1.0
}