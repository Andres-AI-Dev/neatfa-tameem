WorldInfo {
  title "AprilTag Collect and Deposit - ALL TAGS LIT"
}
Viewpoint {
  orientation -0.45375199384834025 0.15517488072861602 0.8775134668308604 2.3467807764883486
  position 4.877050702140805 -6.274987923316595 12.10714747720302
  follow "EPuck_1"
}
TexturedBackground { }
TexturedBackgroundLight { }

Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.85
        roughness 1
        metalness 0
      }
      geometry Box { size 5 5 0.001 }
    }
  ]
  name "floor"
  boundingObject Box { size 5 5 0.001 }
}

DEF DEPOSIT_BASE Solid {
  translation 0 0 0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.6 0.9
        transparency 0.35
        roughness 0.5
        metalness 0.3
        emissiveColor 0.1 0.3 0.5
        emissiveIntensity 0.3
      }
      geometry Cylinder { height 0.1 radius 0.2 }
    }
    Pose {
      translation 0 0 -0.049
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 0.8 0.2
            transparency 0.35
            roughness 0.3
            metalness 0.5
          }
          geometry Cylinder { height 0.002 radius 0.25 }
        }
      ]
    }
  ]
  name "deposit_base"
}

